{
  "name": "ngx-seo",
  "version": "0.1.0",
  "description": "Layered SEO and AEO head management for Angular SSR and SPA lifecycles",
  "license": "MIT",
  "author": "Joseph R. Quinn",
  "keywords": [
    "angular",
    "seo",
    "aeo",
    "ssr",
    "json-ld",
    "open-graph",
    "meta"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.exact.json --noEmit && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release": "pnpm build && pnpm publish dist"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/router": "^21.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-server": "^21.2.26",
    "@angular/router": "^21.2.26",
    "jsdom": "^31.0.1",
    "ng-packagr": "^21.2.7",
    "rxjs": "^7.8.2",
    "schema-dts": "1.1.5",
    "tslib": "^2.9.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
